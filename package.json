{
  "name": "intoto-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Intoto ERP — AI-powered ERP for Indian clothing wholesale & retail",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" dev",
    "dev:api": "pnpm --filter @intoto/api dev",
    "dev:web": "pnpm --filter @intoto/web dev",
    "dev:tracker": "pnpm --filter @intoto/tracker dev",
    "build": "pnpm --filter @intoto/shared build && pnpm --filter @intoto/api build && pnpm --filter @intoto/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @intoto/api test:e2e",
    "_comment_db": "Prisma resolves .env from the working directory, so these run from the repo root against the single root .env rather than needing a copy inside apps/api.",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:push": "prisma db push --schema apps/api/prisma/schema.prisma",
    "db:seed": "pnpm --filter @intoto/api db:seed",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "pnpm -r exec rm -rf dist .next node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "typescript": "^5.7.2"
  }
}
