# Testing
coverage/
.nyc_output/

# Prisma
apps/api/prisma/migrations/dev.db*

# Uploads (local storage driver).
#
# Anchored with a leading slash, and listed per directory, on purpose. A bare `storage/`
# matches a directory of that name at ANY depth — which silently excluded
# apps/api/src/common/storage/, so the API source was incomplete in the repository and
# every clean build failed at `nest build` with "Cannot find module './storage/...'".
# Only these two names, in these two places, are upload directories.
/storage/
/uploads/
apps/api/storage/
apps/api/uploads/

# Tracker's standalone build output — 1 MB of generated HTML, rebuilt in a second
# by `pnpm --filter @intoto/tracker build:standalone`. Committing it would age
# silently against the sources it is assembled from.
apps/tracker/dist/

# Tracker's local JSON store — the fallback used when no DATABASE_URL is set.
# It holds real tracked jobs, so it belongs on the machine, not in the repository.
apps/tracker/data/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Turbo / caches
.turbo/
.cache/
