  LIFO
  WEIGHTED_AVERAGE
}

enum StockMovementType {
  OPENING
  PURCHASE
  PURCHASE_RETURN
  SALE
  SALES_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  DAMAGED
  LOST
  CYCLE_COUNT
  PRODUCTION
}

enum AdjustmentReason {
  DAMAGED
  LOST
  THEFT
  EXPIRED
  COUNT_CORRECTION
  SAMPLE
  GIFT
  OTHER
}

enum AccountType {
  ASSET
