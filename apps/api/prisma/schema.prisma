// ============================================================================
//  INTOTO ERP — DATABASE SCHEMA
//  PostgreSQL 16 · Prisma 6
//
//  Conventions used throughout:
//
//  1. MULTI-TENANCY. Every business table carries `organizationId`. Intoto is one
//     organization today, but scoping from day one is what makes "unlimited shops"
//     and a future multi-company/franchise model a configuration change rather than
//     a rewrite. Every query in the API is scoped by the tenant guard.
//
//  2. MONEY. Stored as Decimal(18, 4) — exact, never float. Four decimal places
//     because per-unit fabric rates and tax fractions need sub-paise precision before
//     the line total is rounded. The API converts to integer paise for arithmetic.
//
//  3. QUANTITY. Decimal(18, 3) — fabric sells in fractional metres.
//
//  4. DELETE vs ARCHIVE. `deletedAt` = soft delete (hidden, recoverable by admin).
//     `archivedAt` = deliberately retired but still referenced by history. The spec
//     asks for both and they mean different things to an accountant.
//
//  5. IMMUTABLE LEDGERS. StockMovement and JournalLine are append-only. Corrections
//     are new reversing rows, never updates. This is what makes the audit trail and
//     the trial balance trustworthy.
//
//  6. AUDIT. Every mutation writes an AuditLog row via a global interceptor.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum ShopType {
  RETAIL
  WHOLESALE
  BOTH
  WAREHOUSE
}

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  CASHIER
  SALES_STAFF
  WAREHOUSE_STAFF
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  LOCKED
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentMode {
  CASH
  UPI
  CARD_DEBIT
  CARD_CREDIT
  NET_BANKING
  CHEQUE
  BANK_TRANSFER
  WALLET
  GIFT_CARD
  STORE_CREDIT
  CREDIT
}

enum PaymentDirection {
  INBOUND // money received (from customers)
  OUTBOUND // money paid (to suppliers, staff, expenses)
}

enum CustomerType {
  RETAIL
  WHOLESALE
  VIP
  REGULAR
  CORPORATE
}

enum SupplyType {
