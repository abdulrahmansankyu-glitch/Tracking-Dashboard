# ============================================================
#  Intoto ERP — Environment Configuration
#  Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ---------- Core ----------
NODE_ENV=development
APP_NAME="Intoto ERP"
APP_URL=http://localhost:3000
API_PORT=4000
API_PREFIX=api/v1

# ---------- Database (PostgreSQL) ----------
POSTGRES_USER=intoto
POSTGRES_PASSWORD=intoto_dev_password
POSTGRES_DB=intoto_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://intoto:intoto_dev_password@localhost:5432/intoto_erp?schema=public"

# ---------- Redis (cache, queues, sessions) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ---------- Auth ----------
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12
TOTP_ISSUER="Intoto ERP"

# OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------- Encryption (field-level, for bank/PAN data) ----------
# 32-byte key, base64 encoded:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---------- Storage ----------
# driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=intoto-erp-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# ---------- AI ----------
# Anthropic powers the AI Advisor, NL search and chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_ENABLED=true
AI_MAX_TOKENS=4096

# ---------- Notifications ----------
# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ENABLED=false

# SMS (MSG91 / Twilio style)
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=INTOTO
SMS_ENABLED=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Intoto ERP <noreply@intoto.example>"
EMAIL_ENABLED=false

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------- India / GST ----------
DEFAULT_STATE_CODE=09
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
FINANCIAL_YEAR_START_MONTH=4

# E-Invoice (NIC IRP sandbox)
EINVOICE_ENABLED=false
EINVOICE_BASE_URL=https://einv-apisandbox.nic.in
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Intoto ERP"
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_VOICE=true

# ---------- Observability ----------
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Backups ----------
BACKUP_ENABLED=false
BACKUP_CRON="0 2 * * *"
BACKUP_S3_BUCKET=intoto-erp-backups
BACKUP_RETENTION_DAYS=30
